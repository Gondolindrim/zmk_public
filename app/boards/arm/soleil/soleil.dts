/dts-v1/;
#include <nordic/nrf52840_qiaa.dtsi>
#include <dt-bindings/zmk/matrix_transform.h>

#include <zephyr/dt-bindings/gpio/nordic-nrf-gpio.h>


/ {
	model = "soleil";
	compatible = "soleil";

	chosen {
		zephyr,code-partition = &code_partition;
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zmk,kscan = &kscan0;
		zmk,matrix_transform = &default_transform;
		zmk,battery = &vbatt;
		/* zephyr,console = &cdc_acm_uart; */
	};

	default_transform: keymap_transform_0 {
		compatible = "zmk,matrix-transform";
		columns = <17>;
		rows = <8>;
		map = <
			RC(0, 0) RC(0, 1) RC(0, 2) RC(0, 3) RC(0, 4) RC(0, 5) RC(0, 6) RC(0, 7) RC(0, 8) RC(0, 9) RC(0,10) RC(0,11) RC(0,12) RC(0,13) RC(0,14) RC(0,15) RC(0,16)
			RC(1, 0) RC(1, 1) RC(1, 2) RC(1, 3) RC(1, 4) RC(1, 5) RC(1, 6) RC(1, 7) RC(1, 8) RC(1, 9) RC(1,10) RC(1,11) RC(1,12) RC(1,13) RC(1,14) RC(1,15) RC(1,16)
			RC(2, 0) RC(2, 1) RC(2, 2) RC(2, 3) RC(2, 4) RC(2, 5) RC(2, 6) RC(2, 7) RC(2, 8) RC(2, 9) RC(2,10) RC(2,11) RC(2,12) RC(2,13) RC(2,14) RC(2,15) RC(2,16)
			RC(3, 0) RC(3, 1) RC(3, 2) RC(3, 3) RC(3, 4) RC(3, 5) RC(3, 6) RC(3, 7) RC(3, 8) RC(3, 9) RC(3,10) RC(3,11)          RC(3,13)
			RC(4, 0)          RC(4, 2) RC(4, 3) RC(4, 4) RC(7, 5) RC(7, 6) RC(7, 7) RC(7, 8) RC(7, 9) RC(7,10) RC(7,11) RC(7,12) RC(7,13)          RC(7,15) RC(7,16)
			RC(5, 0) RC(5, 1) RC(5, 2)                            RC(6, 6)          RC(6, 8) RC(6, 9) RC(6,10)                   RC(6,13) RC(6,14) RC(6,15) RC(6,16)
			>;
	};
 
	kscan0: kscan {
		compatible = "zmk,kscan-gpio-matrix";
		//label = "KSCAN";
		diode-direction = "col2row";
		row-gpios
			= <&gpio1 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // R0
			, <&gpio1 13 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // R1
			, <&gpio1 14 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // R2
			, <&gpio0 27 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // R3
			, <&gpio0  4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // R4
			, <&gpio0 26 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // R5
			, <&gpio0 13 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // R6
			, <&gpio0 12 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // R7
			;
		col-gpios
			= <&gpio0  6 GPIO_ACTIVE_HIGH> // C0
			, <&gpio0 11 GPIO_ACTIVE_HIGH> // C1
			, <&gpio0  8 GPIO_ACTIVE_HIGH> // C2
			, <&gpio0  9 GPIO_ACTIVE_HIGH> // C3
			, <&gpio0 10 GPIO_ACTIVE_HIGH> // C4
			, <&gpio0  7 GPIO_ACTIVE_HIGH> // C5
			, <&gpio0 31 GPIO_ACTIVE_HIGH> // C6
			, <&gpio0 30 GPIO_ACTIVE_HIGH> // C7
			, <&gpio0 29 GPIO_ACTIVE_HIGH> // C8
			, <&gpio0 28 GPIO_ACTIVE_HIGH> // C9
			, <&gpio0  2 GPIO_ACTIVE_HIGH> // C10
			, <&gpio0  3 GPIO_ACTIVE_HIGH> // C11
			, <&gpio1 15 GPIO_ACTIVE_HIGH> // C12
			, <&gpio1 12 GPIO_ACTIVE_HIGH> // C13
			, <&gpio1 11 GPIO_ACTIVE_HIGH> // C14
			, <&gpio1  8 GPIO_ACTIVE_HIGH> // C15
			, <&gpio1  9 GPIO_ACTIVE_HIGH> // C16
			;
	};

     vbatt: vbatt {
         compatible = "zmk,battery-voltage-divider";
         io-channels = <&adc 3>;
         output-ohms = <2000000>;
         full-ohms = <(2000000 + 806000)>;
     };

    leds {
		compatible = "gpio-leds";
		red_red: led_0 {
			gpios = <&gpio1 3 (GPIO_ACTIVE_LOW | GPIO_OPEN_DRAIN)>;
		};
		green_led: led_1 {
			gpios = <&gpio1 5 (GPIO_ACTIVE_LOW | GPIO_OPEN_DRAIN)>;
		};
		blue_led: led_2 {
			gpios = <&gpio1 1 (GPIO_ACTIVE_LOW | GPIO_OPEN_DRAIN)>;
		};
	};
};

&adc {
    status = "okay";
};

&gpiote {
    status = "okay";
};

&gpio0 {
	status = "okay";
};

&gpio1 {
	status = "okay";
};

&usbd {
    status = "okay";
};

